ases/tag/v1.2.1; BOD 26-04: https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk; Forensics Triage Requirements: https://www.cisa.gov/news-events/directives/bod-26-04-implementation-guidance-prioritizing-security-updates-based-risk","urls":["https://nvd.nist.gov/vuln/detail/CVE-2026-111497"],"cwes":["CWE-252","CWE-787"]}],"epss":[{"cve":"CVE-2026-111497","epss":0.82641,"percentile":0.99669,"date":"2026-11-06"}],"cwes":[{"cve":"CVE-2026-111497","cwe":"CWE-252","source":"cve-coordination@google.com","type":"Secondary"},{"cve":"CVE-2026-111497","cwe":"CWE-787","source":"cve-coordination@google.com","type":"Secondary"}],"fix":{"versions":["1.2.7"],"state":"fixed","available":[{"version":"1.2.7","date":"2026-10-23","kind":"release"}]},"advisories":[],"risk":98.70000000000002},"relatedVulnerabilities":[{"id":"CVE-2026-111497","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-111497","namespace":"nvd:cpe","severity":"Critical","urls":["https://github.com/andybalholm/brotli/releases/tag/v1.2.7","https://nodejs.org/en/blog/vulnerability/october-2026-security-releases#nodejs-brotli-decoder-out-of-bounds-write-permits-remote-code-execution-cve-2026-111497---high","http://www.openwall.com/lists/oss-security/2026/10/23/25","http://www.openwall.com/lists/oss-security/2026/10/24/6","http://www.openwall.com/lists/oss-security/2026/10/26/12","http://www.openwall.com/lists/oss-security/2026/10/26/13","http://www.openwall.com/lists/oss-security/2026/10/26/16","http://www.openwall.com/lists/oss-security/2026/11/03/2","https://broccoli2shell.com","https://github.com/advisories/GHSA-9v8h-qqgm-4m35","https://github.com/dotnet/announcements/issues/494","https://github.com/google/brotli/releases/tag/v1.0.10","https://github.com/google/brotli/releases/tag/v1.1.1","https://github.com/google/brotli/releases/tag/v1.2.1","https://lists.debian.org/debian-lts-announce/2026/10/msg00049.html","https://patchtheplanet.org/brotli","https://www.aikido.dev/